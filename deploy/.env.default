# Tier0 deployment environment template.
# Copy this file to .env before install if you want to customize values.
# bin/install.sh also creates .env automatically when it is missing.
# Generated runtime values are written to .env.runtime and should not be edited by hand.

# Instance name shown in UI and install output.
OS_NAME=Tier0

# Product release version shown in UI and used by install/migration state.
PRODUCT_VERSION=dev

# Concrete release images. PRODUCT_VERSION above is the single release-version
# source; change that one value when preparing a new compatible release set.
BACKEND_IMAGE=harbor.tier0.dev/tier0/tier0-edge-backend:${PRODUCT_VERSION}

# UI language, for example en-US or zh-CN.
LANGUAGE=en-US

# Docker Compose project name. It isolates container, network, and volume names.
COMPOSE_PROJECT_NAME=edge

# Add this offset to default published ports for same-host multi-instance
# installs. Explicit per-service port values still take precedence.
PORT_OFFSET=0

# Persistent data root. Use a different path for each local instance.
# On Windows, /volumes/... is resolved under $HOME/volumes/... by the scripts.
# Use a drive-qualified path such as D:/tier0/volumes/data or /d/tier0/volumes/data
# when you want the data on a specific disk.
VOLUMES_PATH=${HOME}/volumes/tier0/data

# Public entrance settings.
ENTRANCE_PROTOCOL=http
ENTRANCE_DOMAIN=127.0.0.1
ENTRANCE_PORT=8088
ENTRANCE_SSL_PORT=8443

# Platform database name when using the built-in TimescaleDB.
UNS_DB_NAME=postgres

# Empty UNS_DB_URL means using the built-in TimescaleDB.
UNS_DB_URL=

# Empty SINK_DB_URL means sharing UNS_DB_URL.
# Set it only when sink/history data needs a separate database.
SINK_DB_URL=

# Number of years to retain time-series history. Applied on Backend startup.
TIMESERIES_RETENTION_YEARS=10

# Empty REDIS_ADDR enables the built-in Redis. Set an external Redis address to
# skip the local Redis container.
REDIS_ADDR=

# Initial admin password. The development default is tier0; override it before exposing the service.
ADMIN_INITIAL_PASSWORD=tier0

# Internal plugin API key. Leave empty to let install.sh generate a stable key.
# It is written to .env.runtime and injected into the backend and retained protocol plugins.
TIER0_API_KEY=
