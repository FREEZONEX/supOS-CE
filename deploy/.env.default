# Deployed server specification
# for test
# supported: windows, linux
OS_PLATFORM_TYPE=linux

OS_NAME=Tier0
VOLUMES_PATH=/volumes/tier0/data

ENTRANCE_PROTOCOL=http
ENTRANCE_DOMAIN=127.0.0.1
ENTRANCE_PORT=8088
ENTRANCE_SSL_PORT=8443

# LANGUAGE setting, supported: en-US, zh-CN
LANGUAGE=en-US

# Description of the tier0 version
OS_VERSION=V2.0.2

# MQTT TCP port
OS_MQTT_TCP_PORT=1883

# MQTT WebSocket TLS port
OS_MQTT_WEBSOCKET_TSL_PORT=8084

# Login path for the system. Leading slashes are optional.
OS_LOGIN_PATH=tier0-login

# Enable or disable authentication (true/false)
OS_AUTH_ENABLE=true

# Model and Key for openai (Enter your api key, can be empty)
LLM_TYPE=openai
LLM_MODEL=gpt-4o
LLM_API_KEY=

# Whether the UNS lazy loading mode is enabled or not, default is false
LAZY_TREE=false

# Maximum age of the token in seconds
TOKEN_MAX_AGE=3600

#--------------------DATABASE CREDENTIALS------------------
# PostgreSQL password (used by postgresql, kong, grafana, marimo)
POSTGRES_PASSWORD=postgres

# TimescaleDB (TSDB) password
TSDB_PASSWORD=postgres
