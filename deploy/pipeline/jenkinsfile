pipeline {
    // 运行环境配置：使用任何可用的 Jenkins Agent
    agent any 

    // 环境变量配置
    environment {
        SOURCE_CODE_URL = "https://gitee.com/supos-community-edition/sup-os-edge.git"
        IMAGE_NAME = "supos-edge-platform" // 替换为你的应用镜像名称
        DOCKER_REGISTRY = "eco-registry.supos.com" // 替换为你的Docker仓库地址 (例如：docker.io, hub.mycompany.com)
        DOCKER_USERNAME = "admin"
        DOCKER_PASSWORD = "Supos1304@"
        FULL_IMAGE_TAG = "${DOCKER_REGISTRY}/sup9bnlh/${IMAGE_NAME}:${TAG}"
        TAG = "${params.TAG}"
        SOURCE_PATH = "/var/jenkins_home/SourceCodes"
        SOURCE_DIR = "supos-edge"
        SOURCE_CODE = "${SOURCE_PATH}/${SOURCE_DIR}"
        CREDENTIALS_ID = '26d0e415-9908-4c00-84dd-98ef04c6f201' // 替换为你的 Jenkins SSH 凭证 ID
        VERSION=''

    }

    parameters {
        booleanParam(
            name: 'Only_Build_Image', 
            defaultValue: false, 
            description: '是否只构建镜像，不打包部署文件'
        )
        booleanParam(
            name: 'Auto_Deploy', 
            defaultValue: true, 
            description: '自动部署到supos-community-edge'
        )
    }

    stages {
        // --------------------------------------------------------------------------------------------------
        stage('1. 克隆源码') {
            steps {
                script {
                    echo "--> 清理工作空间 ${WORKSPACE}..."
                    // 最佳实践：在克隆前清理工作空间
                    cleanWs() 
                }
                
                checkout([$class: 'GitSCM', 
                    branches: [[name: "${TAG}"]], 
                    extensions: [
                        [$class: 'CloneOption', depth: 1,shallow: true,timeout: 3600]
                    ],
                    userRemoteConfigs: [[credentialsId: "${CREDENTIALS_ID}", url: "${SOURCE_CODE_URL}"]]])

                script {
                    //currentBuild.displayName = "#${env.BUILD_NUMBER} - ${BUILD_USER}"
                    sh '''
                        #!/bin/bash
                        ls -l "${WORKSPACE}"
                    '''
                }
            }
        }
        // --------------------------------------------------------------------------------------------------
        stage('2. 构建镜像') {
            steps {
                script {
                    echo "--> 正在构建镜像: ${FULL_IMAGE_TAG}"
                    sh "mkdir -p ./deploy/images"
                    // 构建 Docker 镜像
                    dockerImage = docker.build("${FULL_IMAGE_TAG}", "-f ./deploy/Dockerfile-Compose .")

                    sh '''
                        docker tag ${FULL_IMAGE_TAG} "suposce/supos-edge-platform:${TAG}"
                        docker save  suposce/supos-edge-platform:${TAG} | xz -z -T0 -v >./deploy/images/supos-edge-platform.tar.xz

                        echo "$DOCKER_PASSWORD" | docker login --username "$DOCKER_USERNAME" --password-stdin "$DOCKER_REGISTRY"
                        docker push "${FULL_IMAGE_TAG}"
                    '''
                }
            }
        }
        // --------------------------------------------------------------------------------------------------
        stage('3. 准备部署包') {
            when {
                expression { 
                    return !params.Only_Build_Image 
                }
            }
            steps {
                script {                    
                    dir("deploy") {
                        
                        sh '''
                        ls -all
                        scp -i /var/jenkins_home/ssh/id_rsa "root@172.21.2.148:/home/images/edge/*.tar*" ./images/
                        rm -rf ./pipeline && rm -f Dockerfile-Compose

                        cp -r ../backend/etc ./mount/edge/
                        
                        VERSION=$(grep 'OS_VERSION=' .env.default | cut -d'=' -f2)
                        DATE=$(date +%y%m%d%H)
                        ZipDirAndFileLists=$(ls -a | sed -e 's/^.$//g' -e 's/^..$//g' -e 's/^.git.*//g' |egrep -v '^$')
                        mkdir supOS-edge-${VERSION}-${DATE} && cp -r ${ZipDirAndFileLists} supOS-edge-${VERSION}-${DATE}

                        /var/jenkins_home/paks/zip -q -r -y supOS-edge-${VERSION}-${DATE}.zip supOS-edge-${VERSION}-${DATE}
                        md5sum supOS-edge-${VERSION}-${DATE}.zip > supOS-edge-${VERSION}-${DATE}.zip.md5
                        chmod 664 supOS-edge-${VERSION}-${DATE}.zip*

                        '''
                    }
                }
            }
        }
        // --------------------------------------------------------------------------------------------------
        stage('4. 传输部署包') {
            when {
                expression { 
                    return !params.Only_Build_Image 
                }
            }
            steps {
                script {      
                    dir("deploy") {            
                        sh '''
                        ls -all
                        VERSION=$(grep 'OS_VERSION=' .env.default | cut -d'=' -f2)
                        scp -i /var/jenkins_home/ssh/id_rsa supOS-edge-*.zip* root@172.21.2.136:/home/deploy-packages/edge/${VERSION}/

                        echo "--> 传输完成！"
                        rm -f supOS-edge-*.zip* && rm -rf supOS-edge-${VERSION}-*
                        '''
                    }
                }
            }
        }
        stage('5. 部署到edge服务器') {
            when {
                expression { 
                    return params.Auto_Deploy 
                }
            }
            steps {
                script {      
                    dir("deploy") {            
                        sh """

                        exec_ssh() {
                            ssh -o StrictHostKeyChecking=no \
                                -o ConnectTimeout=10 \
                                -i /var/jenkins_home/ssh/id_rsa \
                                root@172.21.9.198 "\$1"
                        }

                        if [ \$Only_Build_Image = false ]; then

                            sed -i 's|image: suposce/supos-edge-platform:|image: suposce/supos-edge-platform:latest|g' docker-compose-4c8g.yml
                            sed -i 's/^ENTRANCE_DOMAIN=.*/ENTRANCE_DOMAIN=100.100.100.22/' .env.default
                            sed -i 's/^ENTRANCE_PORT=.*/ENTRANCE_PORT=34098/' .env.default

                            scp -i /var/jenkins_home/ssh/id_rsa -r ./* root@172.21.9.198:/root/edge/supos-deploy-edge/
                            exec_ssh "cd /root/edge/supos-deploy-edge/ && ./bin/uninstall.sh && docker rmi -f suposce/supos-edge-platform:latest"
                            exec_ssh "cd /root/edge/supos-deploy-edge/ && ./bin/install.sh"

                        fi

                        if [ \$Only_Build_Image = true ]; then

                            exec_ssh "
                                docker rm -f \$(docker ps -a | grep 'supos-edge-platform' | awk '{print \$1}') || true
                                docker images | grep 'supos-edge-platform' | awk '{print \$1 ":" \$2}' | xargs -r docker rmi
                                docker pull \${FULL_IMAGE_TAG}
                                docker tag \${FULL_IMAGE_TAG} suposce/supos-edge-platform:latest
                                cd /root/edge/supos-deploy-edge/ && docker compose -f docker-compose-4c8g.yml -p supos --env-file .env.default --env-file .env.tmp up -d supos-edge-platform
                            "
                        fi
                        

                        """
                    }
                }
            }
        }
        
    }
    post {
            always {
                // 1. 清理工作空间
                cleanWs()
                dir("${env.WORKSPACE}@tmp") {
                    deleteDir()
                } 
                
                // 2. 清理 Docker
                sh '''
                    echo "=== 清理 Docker 资源 ==="
                    # 清理容器
                    docker container prune -f 2>/dev/null || true
                    # 清理镜像
                    docker image prune -f 2>/dev/null || true
                    # 清理卷
                    docker volume prune -f 2>/dev/null || true
                    # 清理网络
                    docker network prune -f 2>/dev/null || true
                    echo "Docker 清理完成"
                '''
            
            }
            success {
                echo "✅ 构建成功: ${JOB_NAME} #${BUILD_NUMBER}"
                // 可以添加成功通知
            }
            
            failure {
                echo "❌ 构建失败: ${JOB_NAME} #${BUILD_NUMBER}"
                // 可以添加失败通知
            }
        }
}