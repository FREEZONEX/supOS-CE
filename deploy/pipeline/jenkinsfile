pipeline {
    // 运行环境配置：使用任何可用的 Jenkins Agent
    agent any 

    // 环境变量配置
    environment {
        SOURCE_CODE_URL = "https://gitee.com/supos-community-edition/sup-os-edge.git"
        IMAGE_NAME = "supos-edge-platform" // 替换为你的应用镜像名称
        REGISTRY = "eco-registry.supos.com/sup9bnlh" // 替换为你的Docker仓库地址 (例如：docker.io, hub.mycompany.com)
        FULL_IMAGE_TAG = "${REGISTRY}/${IMAGE_NAME}:${TAG}"
        TAG = "${params.TAG}"
        SOURCE_PATH = "/var/jenkins_home/SourceCodes"
        SOURCE_DIR = "supos-edge"
        SOURCE_CODE = "${SOURCE_PATH}/${SOURCE_DIR}"
        CREDENTIALS_ID = '26d0e415-9908-4c00-84dd-98ef04c6f201' // 替换为你的 Jenkins SSH 凭证 ID
        VERSION=''

    }

    stages {
        // --------------------------------------------------------------------------------------------------
        stage('Clone-Source-Code') {
            steps {
                checkout([$class: 'GitSCM', 
                    branches: [[name: "${TAG}"]], 
                    extensions: [
                        [$class: 'CloneOption', depth: 1,shallow: true,timeout: 3600],
                        [$class: 'RelativeTargetDirectory', relativeTargetDir: "${SOURCE_CODE}"]
                    ],
                    userRemoteConfigs: [[credentialsId: "${CREDENTIALS_ID}", url: "${SOURCE_CODE_URL}"]]])

                script {
                    //currentBuild.displayName = "#${env.BUILD_NUMBER} - ${BUILD_USER}"
                    sh '''
                        #!/bin/bash

                        cd "${WORKSPACE}"
                        cp -r "${SOURCE_CODE}" ./
                        ls -l "${SOURCE_DIR}"
                    '''
                }
            }
        }
        // --------------------------------------------------------------------------------------------------
        stage('2. 构建镜像') {
            steps {
                script {
                    dir("${SOURCE_CODE}") {
                        echo "--> 正在构建镜像: ${FULL_IMAGE_TAG}"
                        sh "mkdir -p ./deploy/images"
                        // 构建 Docker 镜像
                        dockerImage = docker.build("${FULL_IMAGE_TAG}", "-f ./deploy/Dockerfile-Compose .")

                        sh '''
                            docker tag ${FULL_IMAGE_TAG} "suposce/supos-edge-platform:${TAG}"
                            docker save  suposce/supos-edge-platform:${TAG} | xz -z -T0 -v >./deploy/images/supos-edge-platform.tar.xz
                        '''
                    }
                    
                    // 推送镜像到远程仓库
                    // docker push "${FULL_IMAGE_TAG}"
                    
                }
            }
        }
        // --------------------------------------------------------------------------------------------------
        stage('3. 准备部署包') {
            steps {
                script {                    
                    dir("${SOURCE_CODE}/deploy") {
                        // 读取版本号
                        def version = sh(
                            script: '''
                                grep 'OS_VERSION=' .env.default | cut -d'=' -f2 | tr -d '\\r" ' | xargs
                            ''',
                            returnStdout: true
                        ).trim()
                        
                        // 保存到环境变量
                        env.VERSION = version

                        sh '''

                        scp -i /var/jenkins_home/ssh/id_rsa "root@172.21.2.148:/home/images/edge/*.tar.xz" ./images/
                        rm -rf ./pipeline && rm -f Dockerfile-Compose

                        DATE=$(date +%y%m%d%H)
                        ZipDirAndFileLists=$(ls -a | sed -e 's/^.$//g' -e 's/^..$//g' -e 's/^.git.*//g' |egrep -v '^$')
                        mkdir supOS-edge-${env.VERSION}-${DATE} && mv ${ZipDirAndFileLists} supOS-edge-${env.VERSION}-${DATE}

                        /var/jenkins_home/paks/zip -q -r -y supOS-edge-${env.VERSION}-${DATE}.zip supOS-edge-${env.VERSION}-${DATE}
                        md5sum supOS-edge-${env.VERSION}-${DATE}.zip > supOS-edge-${env.VERSION}-${DATE}.zip.md5
                        chmod 664 supOS-edge-${env.VERSION}-${DATE}.zip*

                        '''
                    }
                }
            }
        }
        // --------------------------------------------------------------------------------------------------
        stage('4. 传输部署包') {
            steps {
                script {      
                    dir("${SOURCE_CODE}/deploy") {            
                        sh '''
                        ls -all
                        
                        scp -i /var/jenkins_home/ssh/id_rsa supOS-edge-*.zip* root@172.21.2.136:/home/deploy-packages/edge/${env.VERSION}/

                        echo "--> 传输完成！"
                        '''
                    }
                }
            }
        }
        
    }
    post {
            always {
                // 1. 清理工作空间
                cleanWs(
                    cleanWhenAborted: true,
                    cleanWhenFailure: true,
                    cleanWhenNotBuilt: true,
                    cleanWhenSuccess: true,
                    cleanWhenUnstable: true,
                    deleteDirs: true
                )
                
                // 2. 清理 Docker
                sh '''
                    echo "=== 清理 Docker 资源 ==="
                    # 清理容器
                    docker container prune -f 2>/dev/null || true
                    # 清理镜像
                    docker image prune -f 2>/dev/null || true
                    # 清理卷
                    docker volume prune -f 2>/dev/null || true
                    # 清理网络
                    docker network prune -f 2>/dev/null || true
                    echo "Docker 清理完成"
                '''
            
            }
            success {
                echo "✅ 构建成功: ${JOB_NAME} #${BUILD_NUMBER}"
                // 可以添加成功通知
            }
            
            failure {
                echo "❌ 构建失败: ${JOB_NAME} #${BUILD_NUMBER}"
                // 可以添加失败通知
            }
        }
}