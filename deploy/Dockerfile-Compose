# -------------------------
# Stage 1: Build the Go backend
# -------------------------
FROM golang:1.24-alpine AS go-builder

# Set working directory for Go application
WORKDIR /app

# Install necessary system dependencies
RUN apk add --no-cache ca-certificates 

# Set Go proxy and sum database for China
ENV GOPROXY=https://goproxy.cn,direct
ENV GOSUMDB=sum.golang.google.cn
ENV GO111MODULE=on

# Copy Go mod files and download dependencies
COPY ./backend/go.mod ./backend/go.sum ./
RUN go mod download

# Copy Go source code
COPY ./backend/ .

# Build Go application
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -ldflags="-w -s" -o backend ./backend.go


# -----------------------------
# Stage 2: Build the Node.js frontend
# -----------------------------
FROM node:22-alpine AS web-builder

# Set npm registry to China mirror
RUN npm config set registry https://registry.npmmirror.com/

# Set working directory for Node.js app
WORKDIR /app

# Copy package files and apps directory
COPY ./frontend/pnpm-lock.yaml ./frontend/pnpm-workspace.yaml ./frontend/package.json ./frontend/turbo.json ./
COPY ./frontend/apps ./apps
COPY ./frontend/packages ./packages

# Install pnpm and dependencies
RUN npm install -g pnpm
RUN pnpm install

# Build frontend and backend services
RUN pnpm run build:web
RUN pnpm run build:servicesExpress


# -----------------------------
# Stage 3: Final runtime image
# -----------------------------
FROM node:22-alpine

# Install runtime dependencies, including nodejs and npm
RUN apk --no-cache add curl

# Install serve for static file serving
RUN npm install -g serve concurrently pnpm

# Set timezone to Asia/Shanghai
RUN ln -sf /usr/share/zoneinfo/Asia/Shanghai /etc/localtime

# Set working directory for the final image
WORKDIR /app
RUN mkdir -p /app/go-edge/etc

# Copy Go backend binary from the builder stage
COPY --from=go-builder /app/backend ./go-edge/
COPY --from=go-builder /app/etc ./go-edge/etc/
RUN chmod +x ./go-edge/backend

# Copy Node.js web and services build artifacts
COPY --from=web-builder /app/apps/web/dist ./web-dist
COPY --from=web-builder /app/apps/services-express/dist ./services-express-dist
COPY --from=web-builder /app/apps/services-express/package.json ./services-express-dist/
COPY --from=web-builder /app/pnpm-workspace.yaml ./services-express-dist/

# Install production dependencies for Node.js
WORKDIR /app/services-express-dist
RUN pnpm install --production

WORKDIR /app/go-edge

# Expose ports for web and services
EXPOSE 3000 4000 8080

# Start both services concurrently (frontend on port 3000, backend on port 4000)
CMD ["concurrently", \
    "serve -s /app/web-dist -l 3000", \
    "node /app/services-express-dist/index.js", \
    "./backend"]
