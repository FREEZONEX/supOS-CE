{
  "name": "node-red-contrib-opcua-open62541",
  "version": "0.1.0",
  "description": "OPC UA client nodes for Node-RED powered by open62541 with shared connection support",
  "main": "index.js",
  "gypfile": true,
  "scripts": {
    "build": "node-gyp rebuild",
    "build:dev": "OPEN62541_PREFIX=../opcua/.build/open62541-install node-gyp rebuild",
    "clean": "node-gyp clean",
    "test": "node test/addon.test.js && node test/nodes.test.js"
  },
  "keywords": [
    "node-red",
    "opcua",
    "open62541"
  ],
  "author": "Tier0",
  "license": "Apache-2.0",
  "node-red": {
    "nodes": {
      "opcua-connection": "nodes/connection.js",
      "opcua-read": "nodes/read.js",
      "opcua-write": "nodes/write.js",
      "opcua-subscribe": "nodes/subscribe.js"
    }
  },
  "dependencies": {
    "bindings": "^1.5.0",
    "node-addon-api": "^7.0.0"
  },
  "devDependencies": {
    "node-gyp": "^10.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
