{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["build/**", "dist/**"]
    },
    "dev": {
      "persistent": true,
      "cache": false
    },
    "intl:once": {
      "persistent": true,
      "cache": false
    },
    "intl:watch": {
      "persistent": true,
      "cache": false
    },
    "properties:convert": {
      "persistent": true,
      "cache": false
    }
  }
}
