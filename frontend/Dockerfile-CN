# --------------------------------------
# Stage 1: Build the supos-os-edge
# --------------------------------------
FROM node:22-alpine AS web-builder

RUN npm config set registry https://registry.npmmirror.com/

WORKDIR /app

COPY supos-os-web/ ./

RUN npm install -g pnpm
RUN pnpm install
RUN pnpm run build:web

# --------------------------------------
# Stage 2: Combine everything into final image
# --------------------------------------
FROM node:22-alpine

WORKDIR /app

RUN npm config set registry https://registry.npmmirror.com/

COPY --from=platform-builder /app/apps/chat2db-client/chat2db-client/dist ./platform-build
# 2) Copy the "supos-frontend" build artifacts
#    If that build ended up in /app/build, copy to "frontend-build"
COPY --from=frontend-builder /app/build ./frontend-build

# Node backend from supos-frontend (.docker-node)
COPY --from=frontend-builder /app/.docker-node ./.docker-node

# Install global dependencies
RUN npm install -g serve concurrently pnpm

# Install Node backend dependencies
WORKDIR /app/.docker-node
RUN pnpm install

# 创建plugins-build目录
RUN mkdir -p /app/plugins-build

# Expose ports (frontend:3000, node backend: 4000, chat2db frontend:3001)
EXPOSE 3000 3001 4000 3002

# Start all 3 services concurrently
CMD ["concurrently", \
    "serve -s /app/plugins-build -l 3002", \
    "serve -s /app/platform-build -l 3001", \
    "serve -s /app/frontend-build -l 3000", \
    "node /app/.docker-node/index.js"]
