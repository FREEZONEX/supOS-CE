# --------------------------------------
# Stage 1: Build the web application
# --------------------------------------
FROM node:22-alpine AS web-builder

# Increase Node.js max old space for build stage
ENV NODE_OPTIONS=--max-old-space-size=8192

RUN npm config set registry https://registry.npmmirror.com/

WORKDIR /app

# Copy package files
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json turbo.json ./
COPY apps ./apps
COPY packages ./packages

# Install pnpm
RUN npm install -g pnpm@10.13.1

# Then install all dependencies
RUN pnpm install

# Build the static web application.
RUN pnpm run build:web

# Build the anchor sub-application (statically served under /anchor/).
# Its workspace dependency @internal/anchor-bridge must be built first.
RUN pnpm --filter @internal/anchor-bridge build
RUN pnpm --filter anchor build

# --------------------------------------
# Stage 2: Create final runtime image
# --------------------------------------
FROM node:22-alpine

# Increase Node.js max old space for runtime
ENV NODE_OPTIONS=--max-old-space-size=4096

RUN npm config set registry https://registry.npmmirror.com/

WORKDIR /app

# Install serve-handler for static file serving (used by static-server.js)
RUN npm install serve-handler@6

# Copy web build artifacts
COPY --from=web-builder /app/apps/web/dist ./web-dist
COPY --from=web-builder /app/apps/anchor/dist ./web-dist/anchor

# SPA fallbacks: /anchor/** falls back to the anchor sub-app index, everything
# else to the main web index. The previous `serve -s` rewrote /anchor deep
# links to the main index (serve CLI rewrites chain and cannot exclude a
# prefix), which nested the main app inside the anchor iframe.
COPY static-server.js ./static-server.js

# Expose static web port
EXPOSE 3000

# Start static web server
CMD ["node", "/app/static-server.js"]
