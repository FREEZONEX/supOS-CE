syntax = "v1"

@server(
    prefix: /api/core
    group: core/flow
    middleware: SessionAuth, Permission
)
service backend {
    @handler FlowList
    get /flows (FlowListReq) returns (Envelope)

    @handler FlowCreate
    post /flows (FlowSaveReq) returns (Envelope)

    @handler FlowNodeTypes
    get /flows/node-types (NodeRedNodeTypeListReq) returns (Envelope)

    @handler FlowMissingNodeList
    get /flows/missing-nodes (NodeRedMissingNodeListReq) returns (Envelope)

    @handler FlowMissingNodeDelete
    delete /flows/missing-nodes (NodeRedMissingNodeDeleteReq) returns (Envelope)

    @handler FlowMissingNodeCleanup
    post /flows/missing-nodes/cleanup (NodeRedMissingNodeCleanupReq) returns (Envelope)

    @handler FlowDetail
    get /flows/:flowId (FlowIdReq) returns (Envelope)

    @handler FlowUpdate
    put /flows/:flowId (FlowSaveReq) returns (Envelope)

    @handler FlowDelete
    delete /flows/:flowId (FlowIdReq) returns (Envelope)

    @handler FlowDataSave
    put /flows/:flowId/data (FlowDataReq) returns (Envelope)

    @handler FlowMark
    put /flows/:flowId/mark (FlowMarkReq) returns (Envelope)

    @handler FlowStatusUpdate
    put /flows/:flowId/status (FlowStatusReq) returns (Envelope)

    @handler FlowDeploy
    post /flows/:flowId/deploy (FlowDeployReq) returns (Envelope)
}
