info(
    title: "APP密钥管理"
    desc: "APP密钥管理"
    author: "System Generated"
    version: "v1"
)

@server(
    group: supos/group
    prefix: /inter-api/supos/app/secretKey
    middleware: CheckTokenWare,InitCtxsWare
)
service backend {
    @doc "创建密钥"
    @handler create
    post / () returns ()

    @doc "更新密钥状态"
    @handler update
    put / () returns ()

    @doc "查询密钥列表"
    @handler list
    get /list () returns ()

    @doc "删除密钥"
    @handler delete
    delete /:id () returns ()
}

type (
    CreateAppKeyReq {
    }

    UpdateAppKeyReq {
        AppSecretKey string `json:"appSecretKey"`
        Status       int32  `json:"status"`
    }

    AppKeyInfo {
        ID             int64     `json:"id"`
        AppSecretKey   string    `json:"appSecretKey"`
        AppSecretValue string    `json:"appSecretValue"`
        Status         int32     `json:"status"`
        CreateTime     string    `json:"createTime"`
    }

    ListAppKeyResp {
        Code int32         `json:"code"`
        Msg  string        `json:"msg"`
        Data []*AppKeyInfo `json:"data"`
    }
)
