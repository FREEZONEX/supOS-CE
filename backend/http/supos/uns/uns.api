info(
    title: "uns模板"
    desc: "uns模板"
    author: "杨磊"
    email: "603685348@qq.com"
    version: "v1"
)

@server(
    group: supos/uns/uns
    prefix: /inter-api/supos/uns
    middleware:  CheckTokenWare,InitCtxsWare
)
service backend {
    @doc "分页搜索主题"
    @handler search
    post /search () returns ()
    @doc "搜索主题树，默认整个树"
    @handler tree
    post /tree () returns ()
    @doc "清除所有外部topic"
    @handler externalTopicClear
    post /external/topic/clear () returns ()
    @doc "多条件分页查询树结构"
    @handler conditionTree
    post /condition/tree () returns ()
    @doc "枚举数据类型"
    @handler types
    post /types () returns ()
    @doc "查询文件夹详情"
    @handler modelDetail
    get /model () returns ()
    @doc "查询文件详情"
    @handler instance
    post /instance () returns ()
    @doc "外部数据源表的字段定义转uns字段定义"
    @handler ds2fs
    post /ds2fs () returns ()
    @doc "外部JSON定义转uns字段定义"
    @handler json2fs
    post /json2fs () returns ()
    @doc "创建文件夹和文件"
    @handler modelCreate
    post /model (UnsCreateTopicDTO) returns (WithID)
    @doc "修改文件夹或文件明细"
    @handler modelUpdate
    post /detail () returns ()
    @doc "修改文件夹或文件名称"
    @handler name
    put /name () returns ()
    @doc "文件或文件夹修改订阅"
    @handler modelSubscribe
    post /model/subscribe () returns ()
    @doc "预先判断是否有属性关联"
    @handler modelDetect
    post /model/detect () returns ()
    @doc "批量创建文件夹和文件"
    @handler batch
    post /batch () returns ()
    @doc "批量创建文件夹和文件(node-red导入专用)"
    @handler forNodered
    post /for/nodered () returns ()
    @doc "删除前预先判断是否有被引用对象"
    @handler detectIfRemove
    post /detectIfRemove () returns ()
    @doc "删除指定路径下的所有文件夹和文件"
    @handler deletePath
    delete / () returns ()
    @doc "根据别名集合批量删除文件夹和文件"
    @handler batchAlias
    post /batch/alias () returns ()
    @doc "校验指定文件夹夹是否已存在文件夹、文件名称"
    @handler nameDuplication
    post /name/duplication () returns ()
    @doc "批量查询文件实时值"
    @handler fileCurrentBatchQuery
    post /file/current/batchQuery () returns ()
    @doc "批量查询文件历史值"
    @handler fileHistoryBatchQuery
    post /file/history/batch/query () returns ()
    @doc "批量写文件实时值"
    @handler fileCurrentBatchUpdate
    post /file/current/batchUpdate () returns ()
    @doc "外部topic payload解析"
    @handler externalParserTopicPayload
    post /external/parserTopicPayload () returns ()
    @doc "外部topic转UNS"
    @handler externalTopic2Uns
    post /external/topic2Uns () returns ()
}

type (
    
    // 外部/内部创建主题（文件夹/文件）的入参
    UnsCreateTopicDTO{
        // 父级别名（可选），与 ParentId 任选其一
        ParentAlias string `json:"parentAlias,optional"`
        // 父级ID，可与 ParentAlias 任选其一
        ParentID int64 `json:"parentId,optional"`
        // 模板id
        ModelID int64 `json:"modelId,optional"`
        // 自定义别名（可选）
        Alias string `json:"alias,optional"`
        // 名称（文件夹或文件名）
        Name string `json:"name"`
        // 路径类型：1=文件夹 2=文件
        PathType int64 `json:"pathType"`
        // 数据类型（当 PathType=文件 时可指定，如 int/float/bool/string 等编码值）
        DataType int64 `json:"dataType,optional"`
        // 字段定义（当为文件且需定义结构化字段时可填写）
        Fields []FieldDef `json:"fields,optional"`
        // 描述
        Description string `json:"description,optional"`
        // 协议（可选，例如 mqtt/kafka/http 等）
        Protocol string `json:"protocol,optional"`
        // 协议类型/子类型（可选）
        ProtocolType string `json:"protocolType,optional"`
        // 外部数据源ID（可选）
        DataSrcId int64 `json:"dataSrcId,optional"`
        // 是否附带创建仪表盘
        AddDashBoard bool `json:"addDashBoard,optional"`
        // 是否保存数据到库
        Save2db bool `json:"save2db,optional"`
        // 是否创建流程
        AddFlow bool `json:"addFlow,optional"`
        // 标签名称集合（按名称绑定标签）
        LabelNames []string `json:"labelNames,optional"`
        // extend
        Extend map[string]interface{} `json:"extend,optional"`
        // 生成模板
        CreateTemplate bool `json:"createTemplate,optional"`
    }
    // 字段定义（参考 Java DTO 提供的字段）
    FieldDef{
        // 字段名
        Name string `json:"name"`
        // 字段类型：int, long, float, string, boolean
        Type string `json:"type"`
        // 是否唯一约束（新建模板时不生效）
        Unique bool `json:"unique,optional"`
        // 对应的协议字段key（新建模板时不生效）
        Index string `json:"index,optional"`
        // 显式名
        DisplayName string `json:"displayName,optional"`
        // 备注
        Remark string `json:"remark,optional"`
        // 最大长度（string字段类型生效）
        MaxLen int64 `json:"maxLen,optional"`
        // tbValueName（内部使用）
        TbValueName string `json:"tbValueName,optional"`
    }
)
