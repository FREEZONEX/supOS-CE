info(
    title: "Flow Open API"
    desc: "Source Flow Open API"
    author: "System Generated"
    version: "v1"
)

@server(
    group: supos/open
    prefix: /open-api/flow
)
service backend {
    @doc(
        summary: "创建 Flow"
        description: "创建新的 source flow"
    )
    @handler openCreateSourceFlow
    post / (OpenSourceFlowCreateReq) returns (string)

    @doc(
        summary: "查询 Flow 列表"
        description: "分页查询 source flow 列表"
    )
    @handler openListSourceFlows
    get / (OpenSourceFlowListQuery) returns (OpenSourceFlowPageResult)

    @doc(
        summary: "查询 Flow Data"
        description: "按 ID 获取 source flow 的 flowjson"
    )
    @handler openGetSourceFlowData
    get /flowData (OpenSourceFlowDataQuery) returns (OpenSourceFlowDataResp)

    @doc(
        summary: "更新 Flow"
        description: "更新 source flow 基本信息"
    )
    @handler openUpdateSourceFlow
    put / (OpenSourceFlowUpdateReq) returns ()

    @doc(
        summary: "部署 Flow"
        description: "按 ID 部署 source flow，可选覆盖 flows JSON"
    )
    @handler openDeploySourceFlow
    post /deploy (OpenSourceFlowDeployReq) returns (OpenSourceFlowDeployResult)

    @doc(
        summary: "删除 Flow"
        description: "按 ID 删除 source flow"
    )
    @handler openDeleteSourceFlow
    delete / (OpenSourceFlowDeleteReq) returns ()
}

type (
    OpenSourceFlowCreateReq {
        FlowName string `json:"flowName"`
        Description string `json:"description,optional"`
        Template string `json:"template,optional"`
        GroupId *int64 `json:"groupId,optional,string"`
    }

    OpenSourceFlowListQuery {
        Keyword string `form:"k,optional"`
        OrderCode string `form:"orderCode,optional"`
        IsAsc string `form:"isAsc,optional"`
        PageNo int64 `form:"pageNo,optional,default=1"`
        PageSize int64 `form:"pageSize,optional,default=10"`
    }

    OpenSourceFlowUpdateReq {
        ID string `json:"id"`
        FlowName string `json:"flowName"`
        Description string `json:"description,optional"`
    }

    OpenSourceFlowDataQuery {
        ID string `form:"id"`
    }

    OpenSourceFlowDataResp {
        Flows []map[string]interface{} `json:"flows,optional"`
        Rev string `json:"rev,optional"`
    }

    OpenSourceFlowDeployReq {
        ID string `json:"id"`
        Flows []map[string]interface{} `json:"flows,optional"`
    }

    OpenSourceFlowDeleteReq {
        ID string `form:"id"`
    }

    OpenSourceFlowInfo {
        ID string `json:"id,optional"`
        FlowName string `json:"flowName,optional"`
        FlowID string `json:"flowId,optional"`
        Description string `json:"description,optional"`
        FlowStatus string `json:"flowStatus,optional"`
        Template string `json:"template,optional"`
        Mark int `json:"mark,optional"`
        Creator string `json:"creator,optional"`
        CreateTime int `json:"createTime,optional"`
    }

    OpenSourceFlowPageResult {
        Code int `json:"code"`
        PageNo int64 `json:"pageNo"`
        PageSize int64 `json:"pageSize"`
        Total int64 `json:"total"`
        Data []OpenSourceFlowInfo `json:"data,optional"`
    }

    OpenSourceFlowDeployResult {
        FlowID string `json:"flowId,optional"`
        Version string `json:"version,optional"`
    }
)
