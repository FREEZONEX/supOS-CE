syntax = "v1"

type OpenapiFlowInfo {
    id int64 `json:"id"`
    flowId string `json:"flowId"`
    flowName string `json:"flowName"`
    flowType string `json:"flowType"`
    flowStatus string `json:"flowStatus"`
    template string `json:"template"`
    description string `json:"description"`
    isFavorite int64 `json:"isFavorite"`
    createdTime int64 `json:"createdTime"`
    updatedTime int64 `json:"updatedTime"`
}

type OpenapiFlowListResp {
    list []OpenapiFlowInfo `json:"list"`
}

type OpenapiFlowCreateResp {
    id int64 `json:"id"`
    brokerID string `json:"brokerID"`
}

type OpenapiFlowEmptyResp {
    success bool `json:"success"`
}

type OpenapiFlowDeployResp {
    flowId string `json:"flowId"`
}

type OpenapiFlowDataResp {
    rev string `json:"rev"`
    flows []interface{} `json:"flows"`
}

type OpenapiNodeRedNodeSet {
    id string `json:"id"`
    name string `json:"name"`
    types []string `json:"types"`
    enabled bool `json:"enabled"`
    module string `json:"module"`
    version string `json:"version"`
}

type OpenapiFlowNodesResp {
    nodes []OpenapiNodeRedNodeSet `json:"nodes"`
}

@server(
    prefix: /openapi/v1
    group: openapi/v1/flow
    middleware: ApiKeyAuth
)
service backend {
    @handler OpenapiFlowLegacyList
    post /flow/list (OpenapiFlowLegacyListReq) returns (OpenapiFlowListResp)

    @handler OpenapiFlowLegacyGet
    post /flow/get (OpenapiFlowLegacyGetReq) returns (OpenapiFlowInfo)

    @handler OpenapiFlowLegacyCreate
    post /flow/create (OpenapiFlowLegacyCreateReq) returns (OpenapiFlowCreateResp)

    @handler OpenapiFlowLegacyUpdate
    post /flow/update (OpenapiFlowLegacyUpdateReq) returns (OpenapiFlowEmptyResp)

    @handler OpenapiFlowLegacyDelete
    post /flow/delete (OpenapiFlowLegacyDeleteReq) returns (OpenapiFlowEmptyResp)

    @handler OpenapiFlowLegacyFlowData
    post /flow/flowdata (OpenapiFlowLegacyGetReq) returns (OpenapiFlowDataResp)

    @handler OpenapiFlowLegacyDeploy
    post /flow/deploy (OpenapiFlowLegacyDeployReq) returns (OpenapiFlowDeployResp)

    @handler OpenapiFlowLegacyNodes
    post /flow/nodes (OpenapiFlowLegacyNodesReq) returns (OpenapiFlowNodesResp)
}
